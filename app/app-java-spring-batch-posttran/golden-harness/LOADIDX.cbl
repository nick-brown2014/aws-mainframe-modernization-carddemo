       IDENTIFICATION DIVISION.
       PROGRAM-ID. LOADIDX.
      * Load/unload ASCII line-sequential fixtures to/from indexed files
      * MODE (cmd arg): LOAD or DUMP
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT XREF-SEQ ASSIGN TO XREFSEQ
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT ACCT-SEQ ASSIGN TO ACCTSEQ
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT TCAT-SEQ ASSIGN TO TCATSEQ
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT TRAN-SEQ ASSIGN TO TRANSEQ
                  ORGANIZATION IS LINE SEQUENTIAL.
           SELECT XREF-FILE ASSIGN TO XREFFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS X-KEY.
           SELECT ACCT-FILE ASSIGN TO ACCTFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS A-KEY.
           SELECT TCAT-FILE ASSIGN TO TCATBALF
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS T-KEY.
           SELECT TRAN-FILE ASSIGN TO TRANFILE
                  ORGANIZATION IS INDEXED ACCESS MODE IS SEQUENTIAL
                  RECORD KEY IS R-KEY.
       DATA DIVISION.
       FILE SECTION.
       FD XREF-SEQ. 01 XS-REC PIC X(50).
       FD ACCT-SEQ. 01 AS-REC PIC X(300).
       FD TCAT-SEQ. 01 TS-REC PIC X(50).
       FD TRAN-SEQ. 01 RS-REC PIC X(350).
       FD XREF-FILE. 01 X-REC. 05 X-KEY PIC X(16). 05 FILLER PIC X(34).
       FD ACCT-FILE. 01 A-REC. 05 A-KEY PIC 9(11). 05 FILLER PIC X(289).
       FD TCAT-FILE. 01 T-REC. 05 T-KEY PIC X(17). 05 FILLER PIC X(33).
       FD TRAN-FILE. 01 R-REC. 05 R-KEY PIC X(16). 05 FILLER PIC X(334).
       WORKING-STORAGE SECTION.
       01 WS-MODE PIC X(4).
       01 WS-EOF  PIC X VALUE 'N'.
       PROCEDURE DIVISION.
           ACCEPT WS-MODE FROM COMMAND-LINE
           IF WS-MODE = 'LOAD'
              OPEN INPUT XREF-SEQ OUTPUT XREF-FILE
              MOVE 'N' TO WS-EOF
              PERFORM UNTIL WS-EOF = 'Y'
                READ XREF-SEQ AT END MOVE 'Y' TO WS-EOF
                NOT AT END MOVE XS-REC TO X-REC WRITE X-REC END-READ
              END-PERFORM
              CLOSE XREF-SEQ XREF-FILE
              OPEN INPUT ACCT-SEQ OUTPUT ACCT-FILE
              MOVE 'N' TO WS-EOF
              PERFORM UNTIL WS-EOF = 'Y'
                READ ACCT-SEQ AT END MOVE 'Y' TO WS-EOF
                NOT AT END MOVE AS-REC TO A-REC WRITE A-REC END-READ
              END-PERFORM
              CLOSE ACCT-SEQ ACCT-FILE
              OPEN INPUT TCAT-SEQ OUTPUT TCAT-FILE
              MOVE 'N' TO WS-EOF
              PERFORM UNTIL WS-EOF = 'Y'
                READ TCAT-SEQ AT END MOVE 'Y' TO WS-EOF
                NOT AT END MOVE TS-REC TO T-REC WRITE T-REC END-READ
              END-PERFORM
              CLOSE TCAT-SEQ TCAT-FILE
           ELSE
              OPEN INPUT ACCT-FILE OUTPUT ACCT-SEQ
              MOVE 'N' TO WS-EOF
              PERFORM UNTIL WS-EOF = 'Y'
                READ ACCT-FILE NEXT AT END MOVE 'Y' TO WS-EOF
                NOT AT END MOVE A-REC TO AS-REC WRITE AS-REC END-READ
              END-PERFORM
              CLOSE ACCT-SEQ ACCT-FILE
              OPEN INPUT TCAT-FILE OUTPUT TCAT-SEQ
              MOVE 'N' TO WS-EOF
              PERFORM UNTIL WS-EOF = 'Y'
                READ TCAT-FILE NEXT AT END MOVE 'Y' TO WS-EOF
                NOT AT END MOVE T-REC TO TS-REC WRITE TS-REC END-READ
              END-PERFORM
              CLOSE TCAT-SEQ TCAT-FILE
              OPEN INPUT TRAN-FILE OUTPUT TRAN-SEQ
              MOVE 'N' TO WS-EOF
              PERFORM UNTIL WS-EOF = 'Y'
                READ TRAN-FILE NEXT AT END MOVE 'Y' TO WS-EOF
                NOT AT END MOVE R-REC TO RS-REC WRITE RS-REC END-READ
              END-PERFORM
              CLOSE TRAN-SEQ TRAN-FILE
           END-IF
           STOP RUN.
